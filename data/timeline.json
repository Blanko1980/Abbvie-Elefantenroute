  "coda": {
    "scene": "coda",
    "cardDuration": 3.5,
    "fade": 0.3,
    "cards": [
      {
        "title": "Die Frage.",
        "body": "„Was ist der größte Elefant in Ihrer Therapieentscheidung?“ auf Kongress, digital, Social, Print und Mikrosite."
      },
      {
        "title": "Das Sammeln.",
        "body": "Antworten anonym und kuratiert, am Kongress analog (Wand, Sticker), online eher als Auswahl denn als Freitext."
      },
      {
        "title": "Der Elefanten-Check.",
        "body": "Drei Fragen zur eigenen Entscheidungsroutine, mit echten Patientenfällen. Das ist die Brücke von der Haltung zur Substanz."
      },
      {
        "title": "Der Außendienst.",
        "body": "Das Gespräch beginnt bei der Frage, nicht beim Produkt."
      }
    ]
  }
