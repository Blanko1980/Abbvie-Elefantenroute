  "voice": [
    {
      "id": "s1-1",
      "scene": "s1",
      "text": "Das hier ist ein Elefant.",
      "file": "voice/s1-1.mp3",
      "start": 3.892,
      "speechStart": 4,
      "end": 6.217,
      "duration": 2.325,
      "scriptAt": 4,
      "offsetToScript": 0
    },
    {
      "id": "s1-2",
      "scene": "s1",
      "text": "Er lebt seit vielen Jahren in diesem Gebäude.",
      "file": "voice/s1-2.mp3",
      "start": 8,
      "speechStart": 8,
      "end": 11.109,
      "duration": 3.109,
      "scriptAt": 8,
      "offsetToScript": 0
    },
    {
      "id": "s1-3",
      "scene": "s1",
      "text": "Niemand erinnert sich, wann er gekommen ist.",
      "file": "voice/s1-3.mp3",
      "start": 11.609,
      "speechStart": 11.609,
      "end": 14.247,
      "duration": 2.638,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-1",
      "scene": "s2",
      "text": "Elefanten vergessen nichts.",
      "file": "voice/s2-1.mp3",
      "start": 16.247,
      "speechStart": 16.247,
      "end": 18.755,
      "duration": 2.508,
      "scriptAt": 15,
      "offsetToScript": 1.247
    },
    {
      "id": "s2-2",
      "scene": "s2",
      "text": "Sie erinnern sich an jeden Weg, der sie einmal sicher ans Ziel gebracht hat.",
      "file": "voice/s2-2.mp3",
      "start": 19.255,
      "speechStart": 19.255,
      "end": 24.035,
      "duration": 4.78,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-3",
      "scene": "s2",
      "text": "Das ist ihre Stärke.",
      "file": "voice/s2-3.mp3",
      "start": 26.247,
      "speechStart": 26.247,
      "end": 27.867,
      "duration": 1.62,
      "scriptAt": 25,
      "offsetToScript": 1.247
    },
    {
      "id": "s3-1",
      "scene": "s3",
      "text": "Mit den Jahren wird aus Erinnerung Gewohnheit.",
      "file": "voice/s3-1.mp3",
      "start": 37.247,
      "speechStart": 37.247,
      "end": 40.721,
      "duration": 3.474,
      "scriptAt": 36,
      "offsetToScript": 1.247
    },
    {
      "id": "s3-2",
      "scene": "s3",
      "text": "Und aus Gewohnheit wird Platz.",
      "file": "voice/s3-2.mp3",
      "start": 41.421,
      "speechStart": 41.421,
      "end": 43.694,
      "duration": 2.273,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s4-1",
      "scene": "s4",
      "text": "Manchmal ist seine Vorsicht berechtigt.",
      "file": "voice/s4-1.mp3",
      "start": 57.694,
      "speechStart": 57.694,
      "end": 60.437,
      "duration": 2.743,
      "scriptAt": 56,
      "offsetToScript": 1.694
    },
    {
      "id": "s4-2",
      "scene": "s4",
      "text": "Und manchmal ist es nur Gewohnheit, die sich als Vorsicht ausgibt.",
      "file": "voice/s4-2.mp3",
      "start": 61.604,
      "speechStart": 61.694,
      "end": 65.679,
      "duration": 4.075,
      "scriptAt": 60,
      "offsetToScript": 1.694
    },
    {
      "id": "s5-1",
      "scene": "s5",
      "text": "Besonders interessant ist das Verhalten des ausgewachsenen Entscheidungselefanten.",
      "file": "voice/s5-1.mp3",
      "start": 67.583,
      "speechStart": 67.679,
      "end": 72.416,
      "duration": 4.833,
      "scriptAt": 65,
      "offsetToScript": 2.679
    },
    {
      "id": "s5-2",
      "scene": "s5",
      "text": "Er wartet.",
      "file": "voice/s5-2.mp3",
      "start": 72.931,
      "speechStart": 73.016,
      "end": 74.446,
      "duration": 1.515,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-3",
      "scene": "s5",
      "text": "Meist auf das Zeichen, dass der alte Weg nicht mehr trägt.",
      "file": "voice/s5-3.mp3",
      "start": 75.046,
      "speechStart": 75.046,
      "end": 79.069,
      "duration": 4.023,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-4",
      "scene": "s5",
      "text": "Bis dahin wartet jemand anderes mit ihm.",
      "file": "voice/s5-4.mp3",
      "start": 80.173,
      "speechStart": 80.269,
      "end": 82.681,
      "duration": 2.508,
      "scriptAt": 75,
      "offsetToScript": 5.269
    },
    {
      "id": "s7-1",
      "scene": "s7",
      "text": "Der Elefant ist nicht die Therapie.",
      "file": "voice/s7-1.mp3",
      "start": 95.595,
      "speechStart": 95.681,
      "end": 98.547,
      "duration": 2.952,
      "scriptAt": 91,
      "offsetToScript": 4.681
    },
    {
      "id": "s7-2",
      "scene": "s7",
      "text": "Der Elefant ist nicht die Evidenz.",
      "file": "voice/s7-2.mp3",
      "start": 100.047,
      "speechStart": 100.047,
      "end": 103.051,
      "duration": 3.004,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s7-3",
      "scene": "s7",
      "text": "Der Elefant ist die Gewohnheit, mit der wir Evidenz betrachten.",
      "file": "voice/s7-3.mp3",
      "start": 104.551,
      "speechStart": 104.551,
      "end": 108.208,
      "duration": 3.657,
      "scriptAt": null,
      "offsetToScript": null
    }
  ],
  "overlays": [
    {
      "scene": "s2",
      "text": "„Das hat sich bewährt.“",
      "at": 2,
      "start": 17.247,
      "fadeIn": 0.3,
      "visible": 2.5,
      "fadeOut": 0.3
    },
    {
      "scene": "s2",
      "text": "„Damit kenne ich mich aus.“",
      "at": 5,
      "start": 20.247,
      "fadeIn": 0.3,
      "visible": 2.5,
      "fadeOut": 0.3
    },
    {
      "scene": "s2",
      "text": "„Dafür ist die Patientin noch nicht schwer genug.“",
      "at": 8,
      "start": 23.247,
      "fadeIn": 0.3,
      "visible": 2.5,
      "fadeOut": 0.3
    },
    {
      "scene": "s2",
      "text": "„Ich hebe mir das für später auf.“",
      "at": 11,
      "start": 26.247,
      "fadeIn": 0.3,
      "visible": 2.5,
      "fadeOut": 0.3
    },
    {
      "scene": "s4",
      "text": "„Da habe ich Respekt vor.“",
      "at": 4.1,
      "start": 55.794,
      "fadeIn": 0.3,
      "visible": 2.5,
      "fadeOut": 0.3
    }
  ],
  "endcard": {
    "scene": "end",
    "line1": "LASST UNS ÜBER ELEFANTEN REDEN.",
    "line2": "Welcher Elefant bestimmt Ihre Entscheidung?",
    "line1At": 0,
    "line2At": 6,
    "note": "Zeile 1 sofort ohne Überblendung, Zeile 2 ab 6 s darunter, beide bis zum Ende (Entscheidung 13.10.2026)"
  },
  "coda": {
    "scene": "coda",
    "cardDuration": 3.5,
    "fade": 0.3,
    "cards": [
      {
        "title": "Die Frage.",
        "body": "„Was ist der größte Elefant in Ihrer Therapieentscheidung?“ auf Kongress, digital, Social, Print und Mikrosite."
      },
      {
        "title": "Das Sammeln.",
        "body": "Antworten anonym und kuratiert, am Kongress analog (Wand, Sticker), online eher als Auswahl denn als Freitext."
      },
      {
        "title": "Der Elefanten-Check.",
        "body": "Drei Fragen zur eigenen Entscheidungsroutine, mit echten Patientenfällen. Das ist die Brücke von der Haltung zur Substanz."
      },
      {
        "title": "Der Außendienst.",
        "body": "Das Gespräch beginnt bei der Frage, nicht beim Produkt."
      }
    ]
  }
}
