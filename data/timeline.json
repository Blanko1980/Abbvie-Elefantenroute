  "voice": [
    {
      "id": "s1-1",
      "scene": "s1",
      "text": "Das hier ist ein Elefant. Genaugenommen ein Entscheidungselefant.",
      "file": "voice/s1-1.mp3",
      "start": 3.915,
      "speechStart": 4,
      "end": 9.84,
      "duration": 6.818,
      "scriptAt": 4,
      "offsetToScript": 0
    },
    {
      "id": "s1-2",
      "scene": "s1",
      "text": "Er lebt seit vielen Jahren in diesem Gebäude.",
      "file": "voice/s1-2.mp3",
      "start": 11.04,
      "speechStart": 11.04,
      "end": 13.404,
      "duration": 3.109,
      "scriptAt": 8,
      "offsetToScript": 3.04
    },
    {
      "id": "s1-3",
      "scene": "s1",
      "text": "Niemand erinnert sich, wann er gekommen ist.",
      "file": "voice/s1-3.mp3",
      "start": 13.904,
      "speechStart": 13.904,
      "end": 16.151,
      "duration": 2.638,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-1",
      "scene": "s2",
      "text": "Elefanten vergessen nichts.",
      "file": "voice/s2-1.mp3",
      "start": 18.151,
      "speechStart": 18.151,
      "end": 19.991,
      "duration": 2.508,
      "scriptAt": 15,
      "offsetToScript": 3.151
    },
    {
      "id": "s2-2",
      "scene": "s2",
      "text": "Sie erinnern sich an jeden Weg, der sie einmal sicher ans Ziel gebracht hat.",
      "file": "voice/s2-2.mp3",
      "start": 20.491,
      "speechStart": 20.491,
      "end": 24.563,
      "duration": 4.78,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-3",
      "scene": "s2",
      "text": "Das ist ihre Stärke – und das bringt Sicherheit.",
      "file": "voice/s2-3.mp3",
      "start": 28.151,
      "speechStart": 28.151,
      "end": 31.77,
      "duration": 4.023,
      "scriptAt": 25,
      "offsetToScript": 3.151
    },
    {
      "id": "s3-1",
      "scene": "s3",
      "text": "Mit der Zeit wird aus Erinnerung Gewohnheit.",
      "file": "voice/s3-1.mp3",
      "start": 37.151,
      "speechStart": 37.151,
      "end": 39.989,
      "duration": 3.37,
      "scriptAt": 36,
      "offsetToScript": 1.151
    },
    {
      "id": "s3-2",
      "scene": "s3",
      "text": "Und Gewohnheit verstellt den Blick auf Neues.",
      "file": "voice/s3-2.mp3",
      "start": 40.689,
      "speechStart": 40.689,
      "end": 43.279,
      "duration": 2.952,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s4-1",
      "scene": "s4",
      "text": "Neue Wege verunsichern den Elefanten.",
      "file": "voice/s4-1.mp3",
      "start": 50.879,
      "speechStart": 50.879,
      "end": 53.331,
      "duration": 3.291,
      "scriptAt": 52.6,
      "offsetToScript": -1.721
    },
    {
      "id": "s4-2",
      "scene": "s4",
      "text": "Ob er sie aus Gewohnheit oder Vorsicht meidet, ist nicht immer bekannt.",
      "file": "voice/s4-2.mp3",
      "start": 54.531,
      "speechStart": 54.531,
      "end": 58.466,
      "duration": 4.362,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-1",
      "scene": "s5",
      "text": "Besonders interessant ist das Verhalten des ausgewachsenen Entscheidungselefanten.",
      "file": "voice/s5-1.mp3",
      "start": 60.366,
      "speechStart": 60.466,
      "end": 65,
      "duration": 5.329,
      "scriptAt": 65,
      "offsetToScript": -4.534
    },
    {
      "id": "s5-2",
      "scene": "s5",
      "text": "Er verharrt.",
      "file": "voice/s5-2.mp3",
      "start": 65.6,
      "speechStart": 65.6,
      "end": 66.369,
      "duration": 1.515,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-3",
      "scene": "s5",
      "text": "Zwar zeigt er weiter Interesse an neuen Wegen.",
      "file": "voice/s5-3.mp3",
      "start": 66.969,
      "speechStart": 66.969,
      "end": 69.699,
      "duration": 3.344,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-4",
      "scene": "s5",
      "text": "Aber ohne guten Grund, beschreitet er sie nicht.",
      "file": "voice/s5-4.mp3",
      "start": 70.299,
      "speechStart": 70.299,
      "end": 72.868,
      "duration": 3.004,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s7-1",
      "scene": "s7",
      "text": "Der Elefant ist immer da.",
      "file": "voice/s7-1.mp3",
      "start": 86.466,
      "speechStart": 86.466,
      "end": 88.011,
      "duration": 2.09,
      "scriptAt": 91,
      "offsetToScript": -4.534
    },
    {
      "id": "s7-2",
      "scene": "s7",
      "text": "Er begleitet jeden von uns.",
      "file": "voice/s7-2.mp3",
      "start": 89.511,
      "speechStart": 89.511,
      "end": 91.266,
      "duration": 2.22,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s7-3",
      "scene": "s7",
      "text": "Jeden Tag.",
      "file": "voice/s7-3.mp3",
      "start": 92.766,
      "speechStart": 92.766,
      "end": 93.534,
      "duration": 1.384,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s8-1",
      "scene": "s7",
      "text": "Man muss den Entscheidungselefanten bewusst wahrnehmen.",
      "file": "voice/s8-1.mp3",
      "start": 95.034,
      "speechStart": 95.034,
      "end": 97.542,
      "duration": 2.926,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s8-2",
      "scene": "s8",
      "text": "Dann öffnen sich neue Wege.",
      "file": "voice/s8-2.mp3",
      "start": 101.966,
      "speechStart": 101.966,
      "end": 103.737,
      "duration": 2.168,
      "scriptAt": 106.5,
      "offsetToScript": -4.534
    }
  ],
