  "voice": [
    {
      "id": "s1-1",
      "scene": "s1",
      "text": "Das hier ist ein Elefant. Genaugenommen ein Entscheidungselefant.",
      "file": "voice/s1-1.mp3",
      "start": 3.915,
      "speechStart": 4,
      "end": 9.84,
      "duration": 6.818,
      "scriptAt": 4,
      "offsetToScript": 0
    },
    {
      "id": "s1-2",
      "scene": "s1",
      "text": "Er lebt seit vielen Jahren in diesem Gebäude.",
      "file": "voice/s1-2.mp3",
      "start": 11.04,
      "speechStart": 11.04,
      "end": 13.404,
      "duration": 3.109,
      "scriptAt": 8,
      "offsetToScript": 3.04
    },
    {
      "id": "s1-3",
      "scene": "s1",
      "text": "Niemand erinnert sich, wann er gekommen ist.",
      "file": "voice/s1-3.mp3",
      "start": 13.904,
      "speechStart": 13.904,
      "end": 16.151,
      "duration": 2.638,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-1",
      "scene": "s2",
      "text": "Elefanten vergessen nichts.",
      "file": "voice/s2-1.mp3",
      "start": 18.151,
      "speechStart": 18.151,
      "end": 19.991,
      "duration": 2.508,
      "scriptAt": 15,
      "offsetToScript": 3.151
    },
    {
      "id": "s2-2",
      "scene": "s2",
      "text": "Sie erinnern sich an jeden Weg, der sie einmal sicher ans Ziel gebracht hat.",
      "file": "voice/s2-2.mp3",
      "start": 20.491,
      "speechStart": 20.491,
      "end": 24.563,
      "duration": 4.78,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s2-3",
      "scene": "s2",
      "text": "Das ist ihre Stärke – und das bringt Sicherheit.",
      "file": "voice/s2-3.mp3",
      "start": 28.151,
      "speechStart": 28.151,
      "end": 31.77,
      "duration": 4.023,
      "scriptAt": 25,
      "offsetToScript": 3.151
    },
    {
      "id": "s3-1",
      "scene": "s3",
      "text": "Mit der Zeit wird aus Erinnerung Gewohnheit.",
      "file": "voice/s3-1.mp3",
      "start": 39.151,
      "speechStart": 39.151,
      "end": 41.563,
      "duration": 2.691,
      "scriptAt": 36,
      "offsetToScript": 3.151
    },
    {
      "id": "s3-2",
      "scene": "s3",
      "text": "Und Gewohnheit verstellt den Blick auf Neues.",
      "file": "voice/s3-2.mp3",
      "start": 42.263,
      "speechStart": 42.263,
      "end": 44.853,
      "duration": 2.952,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s4-1",
      "scene": "s4",
      "text": "Neue Wege verunsichern den Elefanten.",
      "file": "voice/s4-1.mp3",
      "start": 59.151,
      "speechStart": 59.151,
      "end": 61.542,
      "duration": 2.769,
      "scriptAt": 56,
      "offsetToScript": 3.151
    },
    {
      "id": "s4-2",
      "scene": "s4",
      "text": "Ob er sie aus Gewohnheit oder Vorsicht meidet, ist nicht immer bekannt.",
      "file": "voice/s4-2.mp3",
      "start": 63.151,
      "speechStart": 63.151,
      "end": 67.086,
      "duration": 4.362,
      "scriptAt": 60,
      "offsetToScript": 3.151
    },
    {
      "id": "s5-1",
      "scene": "s5",
      "text": "Besonders interessant ist das Verhalten des ausgewachsenen Entscheidungselefanten.",
      "file": "voice/s5-1.mp3",
      "start": 68.99,
      "speechStart": 69.086,
      "end": 73.052,
      "duration": 4.833,
      "scriptAt": 65,
      "offsetToScript": 4.086
    },
    {
      "id": "s5-2",
      "scene": "s5",
      "text": "Er verharrt.",
      "file": "voice/s5-2.mp3",
      "start": 73.652,
      "speechStart": 73.652,
      "end": 74.421,
      "duration": 1.515,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-3",
      "scene": "s5",
      "text": "Zwar zeigt er weiter Interesse an neuen Wegen.",
      "file": "voice/s5-3.mp3",
      "start": 75.021,
      "speechStart": 75.021,
      "end": 77.751,
      "duration": 3.344,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s5-4",
      "scene": "s5",
      "text": "Aber ohne guten Grund, beschreitet er sie nicht.",
      "file": "voice/s5-4.mp3",
      "start": 78.351,
      "speechStart": 78.351,
      "end": 80.92,
      "duration": 3.004,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s7-1",
      "scene": "s7",
      "text": "Der Elefant ist immer da.",
      "file": "voice/s7-1.mp3",
      "start": 94.988,
      "speechStart": 95.086,
      "end": 96.572,
      "duration": 2.116,
      "scriptAt": 91,
      "offsetToScript": 4.086
    },
    {
      "id": "s7-2",
      "scene": "s7",
      "text": "Er begleitet jeden von uns.",
      "file": "voice/s7-2.mp3",
      "start": 98.072,
      "speechStart": 98.072,
      "end": 99.721,
      "duration": 2.351,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s7-3",
      "scene": "s7",
      "text": "Jeden Tag.",
      "file": "voice/s7-3.mp3",
      "start": 101.221,
      "speechStart": 101.221,
      "end": 102.041,
      "duration": 1.28,
      "scriptAt": null,
      "offsetToScript": null
    },
    {
      "id": "s8-1",
      "scene": "s8",
      "text": "Man muss den Entscheidungselefanten bewusst wahrnehmen.",
      "file": "voice/s8-1.mp3",
      "start": 107.602,
      "speechStart": 107.686,
      "end": 110.44,
      "duration": 3.422,
      "scriptAt": 103.6,
      "offsetToScript": 4.086
    },
    {
      "id": "s8-2",
      "scene": "s8",
      "text": "Dann öffnen sich neue Wege.",
      "file": "voice/s8-2.mp3",
      "start": 114.586,
      "speechStart": 114.586,
      "end": 116.357,
      "duration": 2.168,
      "scriptAt": 110.5,
      "offsetToScript": 4.086
    }
  ],
