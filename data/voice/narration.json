  "lines": [
    {
      "id": "s1-1",
      "scene": "s1",
      "at": 4,
      "minGap": 0,
      "text": "Das hier ist ein Elefant."
    },
    {
      "id": "s1-2",
      "scene": "s1",
      "at": 8,
      "minGap": 1.2,
      "text": "Er lebt seit vielen Jahren in diesem Gebäude."
    },
    {
      "id": "s1-3",
      "scene": "s1",
      "at": null,
      "minGap": 0.5,
      "text": "Niemand erinnert sich, wann er gekommen ist."
    },
    {
      "id": "s2-1",
      "scene": "s2",
      "at": 15,
      "minGap": 0,
      "text": "Elefanten vergessen nichts."
    },
    {
      "id": "s2-2",
      "scene": "s2",
      "at": null,
      "minGap": 0.5,
      "text": "Sie erinnern sich an jeden Weg, der sie einmal sicher ans Ziel gebracht hat."
    },
    {
      "id": "s2-3",
      "scene": "s2",
      "at": 25,
      "minGap": 1.2,
      "text": "Das ist ihre Stärke."
    },
    {
      "id": "s3-1",
      "scene": "s3",
      "at": 36,
      "minGap": 0,
      "text": "Mit den Jahren wird aus Erinnerung Gewohnheit."
    },
    {
      "id": "s3-2",
      "scene": "s3",
      "at": null,
      "minGap": 0.7,
      "text": "Und aus Gewohnheit wird Platz."
    },
    {
      "id": "s4-1",
      "scene": "s4",
      "at": 56,
      "minGap": 0,
      "text": "Manchmal ist seine Vorsicht berechtigt."
    },
    {
      "id": "s4-2",
      "scene": "s4",
      "at": 60,
      "minGap": 1.2,
      "text": "Und manchmal ist es nur Gewohnheit, die sich als Vorsicht ausgibt."
    },
    {
      "id": "s5-1",
      "scene": "s5",
      "at": 65,
      "minGap": 0,
      "text": "Besonders interessant ist das Verhalten des ausgewachsenen Entscheidungselefanten."
    },
    {
      "id": "s5-2",
      "scene": "s5",
      "at": null,
      "minGap": 0.6,
      "text": "Er wartet."
    },
    {
      "id": "s5-3",
      "scene": "s5",
      "at": null,
      "minGap": 0.6,
      "text": "Meist auf das Zeichen, dass der alte Weg nicht mehr trägt."
    },
    {
      "id": "s5-4",
      "scene": "s5",
      "at": 75,
      "minGap": 1.2,
      "text": "Bis dahin wartet jemand anderes mit ihm."
    },
    {
      "id": "s7-1",
      "scene": "s7",
      "at": 91,
      "minGap": 0,
      "text": "Der Elefant ist nicht die Therapie."
    },
    {
      "id": "s7-2",
      "scene": "s7",
      "at": null,
      "minGap": 1.5,
      "text": "Der Elefant ist nicht die Evidenz."
    },
    {
      "id": "s7-3",
      "scene": "s7",
      "at": null,
      "minGap": 1.5,
      "text": "Der Elefant ist die Gewohnheit, mit der wir Evidenz betrachten."
    }
  ]
}