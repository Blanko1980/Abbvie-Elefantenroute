  "lines": [
    {
      "id": "s1-1",
      "scene": "s1",
      "at": 4,
      "minGap": 0,
      "text": "Das hier ist ein Elefant. Genaugenommen ein Entscheidungselefant."
    },
    {
      "id": "s1-2",
      "scene": "s1",
      "at": 8,
      "minGap": 1.2,
      "text": "Er lebt seit vielen Jahren in diesem Gebäude."
    },
    {
      "id": "s1-3",
      "scene": "s1",
      "at": null,
      "minGap": 0.5,
      "text": "Niemand erinnert sich, wann er gekommen ist."
    },
    {
      "id": "s2-1",
      "scene": "s2",
      "at": 15,
      "minGap": 0,
      "text": "Elefanten vergessen nichts."
    },
    {
      "id": "s2-2",
      "scene": "s2",
      "at": null,
      "minGap": 0.5,
      "text": "Sie erinnern sich an jeden Weg, der sie einmal sicher ans Ziel gebracht hat."
    },
    {
      "id": "s2-3",
      "scene": "s2",
      "at": 25,
      "minGap": 1.2,
      "text": "Das ist ihre Stärke – und das bringt Sicherheit."
    },
    {
      "id": "s3-1",
      "scene": "s3",
      "at": 36,
      "minGap": 0,
      "text": "Mit der Zeit wird aus Erinnerung Gewohnheit."
    },
    {
      "id": "s3-2",
      "scene": "s3",
      "at": null,
      "minGap": 0.7,
      "text": "Und Gewohnheit verstellt den Blick auf Neues."
    },
    {
      "id": "s4-1",
      "scene": "s4",
      "at": 56,
      "minGap": 0,
      "text": "Neue Wege verunsichern den Elefanten."
    },
    {
      "id": "s4-2",
      "scene": "s4",
      "at": 60,
      "minGap": 1.2,
      "text": "Ob er sie aus Gewohnheit oder Vorsicht meidet, ist nicht immer bekannt."
    },
    {
      "id": "s5-1",
      "scene": "s5",
      "at": 65,
      "minGap": 0,
      "text": "Besonders interessant ist das Verhalten des ausgewachsenen Entscheidungselefanten."
    },
    {
      "id": "s5-2",
      "scene": "s5",
      "at": null,
      "minGap": 0.6,
      "text": "Er verharrt."
    },
    {
      "id": "s5-3",
      "scene": "s5",
      "at": null,
      "minGap": 0.6,
      "text": "Zwar zeigt er weiter Interesse an neuen Wegen."
    },
    {
      "id": "s5-4",
      "scene": "s5",
      "at": null,
      "minGap": 0.6,
      "text": "Aber ohne guten Grund, beschreitet er sie nicht."
    },
    {
      "id": "s7-1",
      "scene": "s7",
      "at": 91,
      "minGap": 0,
      "text": "Der Elefant ist immer da."
    },
    {
      "id": "s7-2",
      "scene": "s7",
      "at": null,
      "minGap": 1.5,
      "text": "Er begleitet jeden von uns."
    },
    {
      "id": "s7-3",
      "scene": "s7",
      "at": null,
      "minGap": 1.5,
      "text": "Jeden Tag."
    },
    {
      "id": "s8-1",
      "scene": "s8",
      "at": 103.6,
      "minGap": 0,
      "text": "Man muss den Entscheidungselefanten bewusst wahrnehmen."
    },
    {
      "id": "s8-2",
      "scene": "s8",
      "at": 110.5,
      "minGap": 1.0,
      "text": "Dann öffnen sich neue Wege."
    }
  ],
